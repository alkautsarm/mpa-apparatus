# ── Observability (Sentry) ────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your project.
# .env is git-ignored — never commit real values.

# Required: Your Sentry DSN. Find it at Project Settings → Client Keys.
# Leave blank to disable observability entirely (safe for local dev).
VITE_SENTRY_DSN=

# The environment tag sent with every event (e.g. "development", "staging", "production").
VITE_SENTRY_ENVIRONMENT=production

# The release identifier sent with every event. Helps correlate errors to deploys.
# Typically set in CI (e.g. the git SHA or semver tag).
VITE_APP_VERSION=

# ── Sentry CLI / Source Maps (build-time only) ────────────────────────────────
# Required only for source map uploads during `pnpm build`.
# Generate a token at https://sentry.io/settings/account/api/auth-tokens/
# with the `project:releases` and `org:read` scopes.
SENTRY_AUTH_TOKEN=

# Your Sentry organisation slug (from the URL: sentry.io/organizations/<slug>/).
SENTRY_ORG=

# Your Sentry project slug (from the URL: sentry.io/organizations/<org>/projects/<slug>/).
SENTRY_PROJECT=
